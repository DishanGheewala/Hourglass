rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Each person can only ever read or write their own data.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /logs/{logId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.category in ['sleep', 'work', 'free']
          && request.resource.data.hours is number
          && request.resource.data.hours >= 0
          && request.resource.data.hours <= 24
          && (request.resource.data.rating == null
              || (request.resource.data.rating is number
                  && request.resource.data.rating >= 1
                  && request.resource.data.rating <= 10));
      }

      match /deadlines/{dlId} {
        allow read, write: if isOwner(uid);
      }

      // AI chat history and saved notes about the student.
      match /ai/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Private calendar feeds (Apple Calendar link). The token in the document name is an unguessable
    // password: anyone who has it can read that one document, nobody can list them, only the owner can write.
    match /feeds/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
